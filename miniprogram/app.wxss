/**
 * 全局像素街机终端样式与多主题变量（严格兼容微信小程序 WXSS）
 * 对应 evolve_web/rna.html 的主题变量、像素组件与工具类
 */

page,
.app-root {
  --bg-main: #0b0f17;
  --bg-panel: #111827;
  --bg-card: #161f33;
  --bg-card-hover: #1e293b;
  --border-dim: #263248;
  --border-bright: #3b4d6b;
  --text-main: #e2e8f0;
  --text-muted: #94a3b8;
  --text-dim: #64748b;
  --accent-emerald: #10b981;
  --accent-sky: #38bdf8;
  --accent-amber: #f59e0b;
  --accent-purple: #a855f7;
  --accent-rose: #f43f5e;
  --accent-indigo: #6366f1;
  --font-mono: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
}

page {
  width: 100%;
  height: 100%;
  overflow: hidden;
  background-color: var(--bg-main);
  color: var(--text-main);
  font-family: var(--font-mono);
  font-variant-numeric: tabular-nums;
  font-size: 13px;
  line-height: 1.4;
}

view,
text,
button,
scroll-view,
textarea,
canvas {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

.app-root {
  width: 100%;
  height: 100vh;
  overflow: hidden;
  background-color: var(--bg-main);
  color: var(--text-main);
  font-family: var(--font-mono);
  font-variant-numeric: tabular-nums;
  font-size: 13px;
  line-height: 1.4;
}

/* 像素风格边框与按钮 */
.pixel-box {
  background-color: var(--bg-panel);
  border: 2px solid var(--border-dim);
  border-radius: 4px;
}

.pixel-card {
  background-color: var(--bg-card);
  border: 2px solid var(--border-dim);
  border-radius: 4px;
}

.pixel-btn {
  font-family: var(--font-mono);
  border: 2px solid rgba(255, 255, 255, 0.18);
  border-bottom-width: 3px;
  border-radius: 4px;
  margin: 0;
  padding: 0;
  line-height: 1.35;
  font-weight: 400;
  font-size: inherit;
  width: auto;
  min-width: 0;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 4px;
  background-color: transparent;
}

.pixel-btn::after,
.tab-btn::after,
.subtab-btn::after {
  border: none;
  display: none;
}

.pixel-btn-hover {
  transform: translateY(2px);
  border-bottom-width: 2px;
}

.pixel-btn[disabled],
.pixel-btn.is-disabled {
  opacity: 0.45;
  filter: grayscale(0.4);
}

/* CRT 扫描线覆盖层 */
.crt-overlay {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  pointer-events: none;
  z-index: 999;
  background: repeating-linear-gradient(
    0deg,
    rgba(0, 0, 0, 0.16) 0px,
    rgba(0, 0, 0, 0.16) 1px,
    transparent 1px,
    transparent 3px
  );
}

/* 通用工具类 */
.flex { display: flex; }
.flex-col { flex-direction: column; }
.items-center { align-items: center; }
.justify-between { justify-content: space-between; }
.justify-center { justify-content: center; }
.gap-1 { gap: 4px; }
.gap-2 { gap: 8px; }
.gap-3 { gap: 12px; }
.flex-wrap { flex-wrap: wrap; }
.min-w-0 { min-width: 0; }
.flex-1 { flex: 1; }
.shrink-0 { flex-shrink: 0; }
.w-full { width: 100%; }
.text-center { text-align: center; }
.text-xs { font-size: 12px; }
.text-11 { font-size: 11px; }
.text-10 { font-size: 10px; }
.font-bold { font-weight: 700; }
.font-normal { font-weight: 400; }
.hidden { display: none !important; }

.text-main { color: var(--text-main); }
.text-emerald { color: #34d399; }
.text-sky { color: #38bdf8; }
.text-amber { color: #fbbf24; }
.text-purple { color: #c084fc; }
.text-rose { color: #fb7185; }
.text-muted { color: var(--text-muted); }
.text-dim { color: var(--text-dim); }

.bg-emerald,
.bg-emerald[disabled] { background-color: #059669 !important; color: #ffffff !important; }
.bg-sky,
.bg-sky[disabled] { background-color: #0284c7 !important; color: #ffffff !important; }
.bg-indigo,
.bg-indigo[disabled] { background-color: #4f46e5 !important; color: #ffffff !important; }
.bg-amber,
.bg-amber[disabled] { background-color: #d97706 !important; color: #ffffff !important; }
.bg-purple,
.bg-purple[disabled] { background-color: #7e22ce !important; color: #ffffff !important; }
.bg-rose,
.bg-rose[disabled] { background-color: #e11d48 !important; color: #ffffff !important; }
.bg-slate,
.bg-slate[disabled] { background-color: #334155 !important; color: #cbd5e1 !important; }

/* 亮色主题对比度适配 (light / gruvboxLight) */
.theme-light-mode .pixel-box,
.theme-light-mode .kpi-pill,
.theme-light-mode .mission-banner,
.theme-light-mode .left-res-section,
.theme-light-mode .res-mini-card,
.theme-light-mode .tab-bar,
.theme-light-mode .tab-btn {
  background-color: var(--bg-panel);
  color: var(--text-main);
}

.theme-light-mode .tab-btn.active,
.theme-light-mode .subtab-btn.active {
  background-color: #0284c7 !important;
  color: #ffffff !important;
}

.theme-light-mode .subtab-btn {
  background-color: #f1f5f9;
  color: #334155;
  border-color: #cbd5e1;
}

.theme-light-mode .weather-strip {
  background: #e2e8f0;
  color: #334155;
  border-color: #cbd5e1;
}

.theme-light-mode .click-hint-badge {
  color: #065f46;
  background: rgba(16, 185, 129, 0.16);
  border-color: #059669;
}

.theme-light-mode .era-name-text,
.theme-light-mode .mission-text-main,
.theme-light-mode .res-mini-name,
.theme-light-mode .era-lore-text {
  color: var(--text-main) !important;
}

.theme-light-mode .text-emerald { color: #047857; }
.theme-light-mode .text-sky { color: #0369a1; }
.theme-light-mode .text-amber { color: #b45309; }
.theme-light-mode .text-purple { color: #7e22ce; }
.theme-light-mode .text-rose { color: #be123c; }
