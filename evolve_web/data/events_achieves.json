{
  "events": [
    { "id": "shooting_star", "type": "minor", "minEra": 1, "text": "一颗璀璨流星划破夜空，学者们观测天文获得了灵感 (+知识)。", "effect": { "resPct": { "knowledge": 0.04 } } },
    { "id": "meteor_shower", "type": "minor", "minEra": 1, "text": "绚丽的流星雨倾泻而下，全城居民士气微增，天文学家记下星象 (+知识)。", "effect": { "resPct": { "knowledge": 0.06 }, "moraleTemp": 3 } },
    { "id": "tumbleweed", "type": "minor", "minEra": 1, "text": "风滚草吹遍了整座城市街头，市民略感荒凉。", "effect": {} },
    { "id": "furryfish", "type": "minor", "minEra": 1, "text": "媒体大肆传闻一种长毛小鱼，虽然没人亲眼见过，但寻找毛毛鱼成为街头时尚！", "effect": { "moraleTemp": 2 } },
    { "id": "cucumber", "type": "minor", "minEra": 1, "text": "一位市民品尝了藤蔓上的恐怖圆柱蔬菜（实际为黄瓜）后呕吐不止，引发一阵喧闹。", "effect": {} },
    { "id": "heatwave", "type": "minor", "minEra": 1, "text": "热浪突然袭击了整座城市，气温升高为【炎热】。", "effect": { "setTemp": 2 } },
    { "id": "coldsnap", "type": "minor", "minEra": 1, "text": "突如其来的寒流席卷领地，气温骤降为【寒冷】。", "effect": { "setTemp": 0 } },
    { "id": "dark_cloud", "type": "minor", "minEra": 1, "text": "乌云密布天际，大雨随时可能降临。", "effect": { "setWeather": 4 } },
    { "id": "sun_burst", "type": "minor", "minEra": 1, "text": "阳光穿透云层照耀沃土，天气转为晴朗！", "effect": { "setWeather": 0 } },
    { "id": "ruins", "type": "major", "minEra": 1, "reqAncient": true, "text": "考古队在地下发掘出一座远古先祖遗迹，带回大量基础物资！", "effect": { "resMultiPct": { "food": 0.12, "lumber": 0.12, "stone": 0.12, "iron": 0.15, "copper": 0.15 } } },
    { "id": "klepto", "type": "major", "minEra": 2, "text": "一队商旅在集市顺手拾得无主珍宝与钱币 (+金币)。", "effect": { "resPct": { "money": 0.08 } } },
    { "id": "dollar", "type": "minor", "minEra": 2, "text": "财政司在旧金库夹层中清点出遗失的零散钱币 (+金币)。", "effect": { "resFlat": { "money": 45 } } },
    { "id": "contest", "type": "minor", "minEra": 2, "text": "城邦举办了盛大的全城角力与艺术竞赛，街头欢呼声不断 (+士气)！", "effect": { "moraleTemp": 5 } },
    { "id": "discover_oil", "type": "major", "minEra": 2, "text": "勘探队意外在岩层裂隙中发现了一处天然浅层油田 (+石油/煤)！", "effect": { "resFlat": { "coal": 35, "oil": 20 } } },
    { "id": "mine_collapse", "type": "major", "minEra": 2, "text": "深处矿井发生局部坍塌事故，工头迅速组织抢险并损失了少量矿产。", "effect": { "resPct": { "stone": -0.04, "iron": -0.04 } } },
    { "id": "flashmob", "type": "minor", "minEra": 3, "text": "一群青年在中心广场表演了一套无懈可击的机械快闪舞蹈，众人拍手叫绝！", "effect": { "moraleTemp": 4 } },
    { "id": "planking", "type": "minor", "minEra": 3, "text": "拍“扑街照”忽然成为城市里的潮流文化，看起来蠢萌蠢萌的。", "effect": {} },
    { "id": "scandal", "type": "major", "minEra": 3, "text": "一家小报刊登了一则关于市政预算的狗仔八卦，引来些许市民议论 (-士气 2%)。", "effect": { "moraleTemp": -3 } },
    { "id": "protest", "type": "major", "minEra": 2, "reqGov": "republic", "text": "共和体制下，两派市民就披萨是否应该加菠萝展开激烈游行抗议！", "effect": { "moraleTemp": -5 } },
    { "id": "solar_boom", "type": "major", "minEra": 4, "text": "强烈的电离层磁暴意外启发了高能物理小组的实验突破 (+知识/电子)！", "effect": { "resPct": { "knowledge": 0.08, "electronics": 0.06 } } },
    { "id": "quantum_echo", "type": "major", "minEra": 5, "text": "超算中心捕获到一组极其规律的宇宙微波脉冲信号，算力与知识瞬间飙升！", "effect": { "resPct": { "knowledge": 0.10, "money": 0.05 } } },
    { "id": "asteroid_gift", "type": "major", "minEra": 6, "text": "一颗近地小行星被捕获并顺利分解入库 (+氦-3 / 稀有矿物)！", "effect": { "resPct": { "helium3": 0.12, "rareMineral": 0.12 } } }
  ],
